# Copy to deploy/unraid.env on Unraid and fill in the private values. Keep this file out of git.
# The deployment uses the existing arr network and the same /data tree as Sonarr/Radarr.
UNRAID_DOWNLOADS_PATH=/mnt/user/data
UNRAID_APPDATA_PATH=/mnt/user/appdata/stackarr
UNRAID_TAILSCALE_STATE_PATH=/mnt/user/appdata/stackarr/tailscale

MEDIA_DOWNLOAD_CLIENTS=filesystem
MEDIA_DRY_RUN=true
MEDIA_HTTP_TIMEOUT=10
MEDIA_STATE_PATH=/config/state.db
MEDIA_AUTH_TOKEN=replace-with-a-long-random-token

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=replace-me
RADARR_URL=http://radarr:7878
RADARR_API_KEY=replace-me

PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=replace-me

# Optional Jellyfin adapter. Fill both values together when a Jellyfin API key is available.
# JELLYFIN_URL=http://Jellyfin:8096
# JELLYFIN_API_KEY=replace-me

# qBittorrent is behind Gluetun. Its WebUI/API endpoint is GluetunVPN:8080, not qbittorrent:8080.
# Enable it only after supplying the existing WebUI password:
# MEDIA_DOWNLOAD_CLIENTS=filesystem,qbittorrent
# QBITTORRENT_URL=http://GluetunVPN:8080
# QBITTORRENT_USERNAME=replace-me
# QBITTORRENT_PASSWORD=replace-me

# Optional alternative download client. Add sabnzbd to MEDIA_DOWNLOAD_CLIENTS when used.
# SABNZBD_URL=http://sabnzbd:8080
# SABNZBD_API_KEY=replace-me
